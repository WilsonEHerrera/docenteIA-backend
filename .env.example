NODE_ENV=development
PORT=3001
# App connection (pooler, transaction mode)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require&pgbouncer=true
# Migrations connection (direct or session pooler)
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Comma-separated allow-list
CORS_ORIGINS=http://localhost:3000

JWT_ACCESS_SECRET=
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_PER_MIN=10
RESET_TOKEN_TTL_MINUTES=30
# % of maxAbsences at which the course is flagged (shown in the panel; no emails are sent)
ABSENCE_ALERT_THRESHOLD_PCT=80
# AI layer (only "fake" adapters exist for now)
AI_PROVIDER=fake
AI_TIMEOUT_MS=15000
# Total attempts per AI call, first try included
AI_MAX_RETRIES=3
# 0 = no daily limit
AI_DAILY_LIMIT_PER_INSTITUTION=500
FACE_MATCH_THRESHOLD=0.9
# Key for biometric data at rest (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BIOMETRIC_ENCRYPTION_KEY=
